# =================================================================
# CodeSync: AI-Assisted Real-Time Collaborative Code Sync
# Environment Configuration Template
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Primary Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local Fallback Database (SQLite)
# Set USE_SQLITE_FALLBACK=true to run without external PostgreSQL/Supabase
USE_SQLITE_FALLBACK=true
SQLITE_PATH=./database/codesync.sqlite

# Security & Authentication
JWT_SECRET=codesync-super-secret-jwt-key-2026-btech-cse
JWT_EXPIRES_IN=7d

# Machine Learning Service (Python FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000

# Contextual AI Assistance (LLM Provider)
# When LLM_API_KEY is not configured, CodeSync uses an intelligent deterministic
# contextual analyzer fallback that generates precise impact & fix guidance.
LLM_PROVIDER=gemini
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gemini-1.5-pro

# GitHub Integration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_TOKEN=your-personal-access-token
